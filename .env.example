# ===== apps/web/.env =====
# Salin bagian ini ke apps/web/.env lalu isi. JANGAN commit file .env.

# Xendit test mode (Dashboard > Settings > API Keys, mode TEST)
XENDIT_SECRET_KEY=xnd_development_xxx
# Xendit Dashboard > Settings > Webhooks > Webhook verification token
XENDIT_CALLBACK_TOKEN=xxx
APP_BASE_URL=http://localhost:3000
# simulation = pembayaran disimulasikan tanpa Xendit; xendit = Xendit test mode.
# Kosongkan untuk otomatis: xendit jika XENDIT_SECRET_KEY terisi, selain itu simulation.
PAYMENT_MODE=

DATABASE_URL=file:./dev.db

# Pencatatan on-chain (Sepolia). Kosongkan OPERATOR_PRIVATE_KEY untuk menonaktifkan.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key wallet KHUSUS testnet (sama dengan contracts/.env).
OPERATOR_PRIVATE_KEY=0xxxx
# Alamat BayarRapiLedger yang sudah di-deploy kelompok 3
LEDGER_CONTRACT_ADDRESS=0x82C35E808366bd38D8d948359FCbC1a9776675DE

# ===== contracts/.env =====
# Salin dua baris ini ke contracts/.env.
# Private key wallet KHUSUS testnet. Jangan pakai wallet yang berisi aset nyata.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# OPERATOR_PRIVATE_KEY=0xxxx
