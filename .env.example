# Salin ke apps/web/.env.local dan isi. JANGAN commit file .env.local.

# Xendit test mode (Dashboard > Settings > API Keys, mode TEST)
XENDIT_SECRET_KEY=xnd_development_xxx
# Xendit Dashboard > Settings > Webhooks > Verification token
XENDIT_CALLBACK_TOKEN=xxx

# Ethereum Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/xxx
# Private key wallet KHUSUS testnet, jangan wallet berisi aset nyata
OPERATOR_PRIVATE_KEY=0xxxx
LEDGER_CONTRACT_ADDRESS=0x

DATABASE_URL=file:./dev.db
