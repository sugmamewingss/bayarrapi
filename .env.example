# ===== apps/web/.env =====
# Salin bagian ini ke apps/web/.env lalu isi. JANGAN commit file .env.

# Xendit test mode (Dashboard > Settings > API Keys, mode TEST)
XENDIT_SECRET_KEY=xnd_development_xxx
# Xendit Dashboard > Settings > Webhooks > Webhook verification token
XENDIT_CALLBACK_TOKEN=xxx
APP_BASE_URL=http://localhost:3000

DATABASE_URL=file:./dev.db

# Diisi setelah contract di-deploy (Irfan)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/xxx
OPERATOR_PRIVATE_KEY=0xxxx
LEDGER_CONTRACT_ADDRESS=0x

# ===== contracts/.env =====
# Salin dua baris ini ke contracts/.env.
# Private key wallet KHUSUS testnet. Jangan pakai wallet yang berisi aset nyata.
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/xxx
# OPERATOR_PRIVATE_KEY=0xxxx
